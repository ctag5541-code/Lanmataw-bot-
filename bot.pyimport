import logging
from telegram import Update, ChatPermissions
from telegram.ext import (
    ApplicationBuilder, CommandHandler, MessageHandler, 
    ContextTypes, filters
)

# Logging Setup
logging.basicConfig(format='%(asctime)s - %(name)s - %(levelname)s - %(message)s', level=logging.INFO)

BOT_TOKEN = "YOUR_BOT_TOKEN_HERE"  # ဒီနေရာတွင် မိမိ၏ Telegram Bot Token ကို ထည့်ပါ

# ----------------- Database Setup -----------------
def init_db(): conn = 
    sqlite3.connect("group_bot.db") c = 
    conn.cursor() c.execute('''CREATE TABLE IF 
    NOT EXISTS warns (chat_id INTEGER, user_id 
    INTEGER, count INTEGER, PRIMARY KEY 
    (chat_id, user_id))''') 
    c.execute('''CREATE TABLE IF NOT EXISTS 
    autoreplies (chat_id INTEGER, keyword 
    TEXT, response TEXT, PRIMARY KEY (chat_id, 
    keyword))''') c.execute('''CREATE TABLE IF 
    NOT EXISTS filters (chat_id INTEGER, word 
    TEXT, PRIMARY KEY (chat_id, word))''') 
    c.execute('''CREATE TABLE IF NOT EXISTS 
    settings (chat_id INTEGER PRIMARY KEY, 
    lock_url INTEGER, lock_forward 
    INTEGER)''') conn.commit() conn.close()
init_db()
# Helper Functions
def is_admin(chat_member) -> bool: return 
    chat_member.status in ['administrator', 
    'creator']
def get_target_user(update: Update): if 
    update.message and 
    update.message.reply_to_message:
        return 
        update.message.reply_to_message.from_user
    return None
# ----------------- Service Messages Auto 
# Deleter -----------------
async def delete_service_messages(update: 
Update, context: ContextTypes.DEFAULT_TYPE):
    try: await update.message.delete() except 
    Exception as e:
        logging.error(f"Failed to delete 
        service message: {e}")
# ----------------- Admin Ban / Mute / Kick / 
# Warn -----------------
async def ban(update: Update, context: 
ContextTypes.DEFAULT_TYPE):
    admin = await 
    update.effective_chat.get_member(update.effective_user.id) 
    if not is_admin(admin): return
    
    user = get_target_user(update) if not 
    user:
        await update.message.reply_text("⚠️ Ban 
        ချင်တဲ့သူရဲ့ Message ကို Reply ပြန်ပြီး /ban ဟု 
        ရိုက်ပါ။") return
    
    await 
    update.effective_chat.ban_member(user.id) 
    await update.message.reply_text(f"⛔ 
    {user.mention_html()} ကို Group မှ Ban 
    လိုက်ပါပြီ။", parse_mode='HTML')
async def unban(update: Update, context: 
ContextTypes.DEFAULT_TYPE):
    admin = await 
    update.effective_chat.get_member(update.effective_user.id) 
    if not is_admin(admin): return
    
    if not context.args: await 
        update.message.reply_text("⚠️ `/unban 
        <User_ID>` ပုံစံဖြင့် ရိုက်ပါ။", 
        parse_mode='Markdown') return
    
    user_id = int(context.args[0]) await 
    update.effective_chat.unban_member(user_id) 
    await update.message.reply_text(f"✅ User 
    ID `{user_id}` ကို Unban လုပ်ပေးလိုက်ပါပြီ။", 
    parse_mode='Markdown')
async def mute(update: Update, context: 
ContextTypes.DEFAULT_TYPE):
    admin = await 
    update.effective_chat.get_member(update.effective_user.id) 
    if not is_admin(admin): return
    
    user = get_target_user(update) if not 
    user: return
    
    await 
    update.effective_chat.restrict_member(user.id, 
    permissions=ChatPermissions(can_send_messages=False)) 
    await update.message.reply_text(f"🔇 
    {user.mention_html()} ကို Mute လုပ်လိုက်ပါပြီ။", 
    parse_mode='HTML')
async def unmute(update: Update, context: 
ContextTypes.DEFAULT_TYPE):
    admin = await 
    update.effective_chat.get_member(update.effective_user.id) 
    if not is_admin(admin): return
    
    user = get_target_user(update) if not 
    user: return
    
    await 
    update.effective_chat.restrict_member(
        user.id, 
        permissions=ChatPermissions(can_send_messages=True, 
        can_send_media_messages=True, 
        can_send_other_messages=True)
    )
    await update.message.reply_text(f"🔊 {user.mention_html()} ကို Unmute လုပ်ပေးလိုက်ပါပြီ။", parse_mode='HTML')

async def kick(update: Update, context: ContextTypes.DEFAULT_TYPE):
    admin = await update.effective_chat.get_member(update.effective_user.id)
    if not is_admin(admin): return
    
    user = get_target_user(update)
    if not user: return
    
    await update.effective_chat.ban_member(user.id)
    await update.effective_chat.unban_member(user.id)
    await update.message.reply_text(f"👞 {user.mention_html()} ကို Group မှ Kick လိုက်ပါပြီ။", parse_mode='HTML')

async def warn(update: Update, context: ContextTypes.DEFAULT_TYPE):
    admin = await update.effective_chat.get_member(update.effective_user.id)
    if not is_admin(admin): return
    
    user = get_target_user(update)
    if not user: return
    
    chat_id = update.effective_chat.id
    conn = sqlite3.connect("group_bot.db")
    c = conn.cursor()
    c.execute("SELECT count FROM warns WHERE chat_id=? AND user_id=?", (chat_id, user.id))
    res = c.fetchone()
    count = (res[0] + 1) if res else 1
    
    if count >= 3:
        c.execute("DELETE FROM warns WHERE chat_id=? AND user_id=?", (chat_id, user.id))
        conn.commit()
        await update.effective_chat.ban_member(user.id)
        await update.message.reply_text(f"⚠️ {user.mention_html()} သည် Warn (၃) ကြိမ် ပြည့်သွားသဖြင့် Ban ခဲ့ရပါသည်။", parse_mode='HTML')
    else:
        c.execute("INSERT OR REPLACE INTO warns VALUES (?, ?, ?)", (chat_id, user.id, count))
        conn.commit()
        await update.message.reply_text(f"⚠️ {user.mention_html()} ကို သတိပေးလိုက်ပါပြီ။ Warning: ({count}/3)", parse_mode='HTML')
    conn.close()

async def unwarn(update: Update, context: ContextTypes.DEFAULT_TYPE):
    admin = await update.effective_chat.get_member(update.effective_user.id)
    if not is_admin(admin): return
    
    user = get_target_user(update)
    if not user: return
    
    conn = sqlite3.connect("group_bot.db")
    c = conn.cursor()
    c.execute("DELETE FROM warns WHERE chat_id=? AND user_id=?", (update.effective_chat.id, user.id))
    conn.commit()
    conn.close()
    await update.message.reply_text(f"✅ {user.mention_html()} ၏ Warning များကို ပယ်ဖျက်ပေးလိုက်ပါပြီ။", parse_mode='HTML')

async def warns(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = get_target_user(update) or update.effective_user
    conn = sqlite3.connect("group_bot.db")
    c = conn.cursor()
    c.execute("SELECT count FROM warns WHERE chat_id=? AND user_id=?", (update.effective_chat.id, user.id))
    res = c.fetchone()
    conn.close()
    
    count = res[0] if res else 0
    await update.message.reply_text(f"📊 {user.mention_html()} တွင် Warn ရရှိထားမှု: ({count}/3)", parse_mode='HTML')

# ----------------- Locking System -----------------

async def lock(update: Update, context: ContextTypes.DEFAULT_TYPE):
    admin = await update.effective_chat.get_member(update.effective_user.id)
    if not is_admin(admin): return
    
    if not context.args:
        await update.message.reply_text("⚠️ `/lock url` သို့မဟုတ် `/lock forward` ဟု သုံးပါ။", parse_mode='Markdown')
        return
    
    item = context.args[0].lower()
    chat_id = update.effective_chat.id
    conn = sqlite3.connect("group_bot.db")
    c = conn.cursor()
    
    if item == "url":
        c.execute("INSERT INTO settings (chat_id, lock_url) VALUES (?, 1) ON CONFLICT(chat_id) DO UPDATE SET lock_url=1", (chat_id,))
        await update.message.reply_text("🔒 **URL / Links များ ပို့ခြင်းကို ပိတ်လိုက်ပါပြီ။**", parse_mode='Markdown')
    elif item == "forward":
        c.execute("INSERT INTO settings (chat_id, lock_forward) VALUES (?, 1) ON CONFLICT(chat_id) DO UPDATE SET lock_forward=1", (chat_id,))
        await update.message.reply_text("🔒 **Forward Messages များ ပို့ခြင်းကို ပိတ်လိုက်ပါပြီ။**", parse_mode='Markdown')
    conn.commit()
    conn.close()

async def unlock(update: Update, context: ContextTypes.DEFAULT_TYPE):
    admin = await update.effective_chat.get_member(update.effective_user.id)
    if not is_admin(admin): return
    
    if not context.args: return
    item = context.args[0].lower()
    chat_id = update.effective_chat.id
    conn = sqlite3.connect("group_bot.db")
    c = conn.cursor()
    
    if item == "url":
        c.execute("UPDATE settings SET lock_url=0 WHERE chat_id=?", (chat_id,))
        await update.message.reply_text("🔓 **URL များ ပို့ခွင့် ပြန်လည် ဖွင့်ပေးလိုက်ပါပြီ။**", parse_mode='Markdown')
    elif item == "forward":
        c.execute("UPDATE settings SET lock_forward=0 WHERE chat_id=?", (chat_id,))
        await update.message.reply_text("🔓 **Forward Messages များ ပို့ခွင့် ပြန်လည် ဖွင့်ပေးလိုက်ပါပြီ။**", parse_mode='Markdown')
    conn.commit()
    conn.close()

# ----------------- AutoReply & Filter Commands -----------------

async def add_autoreply(update: Update, context: ContextTypes.DEFAULT_TYPE):
    admin = await update.effective_chat.get_member(update.effective_user.id)
    if not is_admin(admin): return
    
    try:
        text = update.message.text.split(" ", 2)
        keyword, response = text[1].lower(), text[2]
        conn = sqlite3.connect("group_bot.db")
        c = conn.cursor()
        c.execute("INSERT OR REPLACE INTO autoreplies VALUES (?, ?, ?)", (update.effective_chat.id, keyword, response))
        conn.commit()
        conn.close()
        await update.message.reply_text(f"✅ AutoReply ထည့်သွင်းပြီးပါပြီ: `{keyword}` -> `{response}`", parse_mode='Markdown')
    except IndexError:
        await update.message.reply_text("⚠️ အသုံးပြုနည်း: `/autoreply <keyword> <response>`")

async def add_filter(update: Update, context: ContextTypes.DEFAULT_TYPE):
    admin = await update.effective_chat.get_member(update.effective_user.id)
    if not is_admin(admin): return
    
    if context.args:
        word = context.args[0].lower()
        conn = sqlite3.connect("group_bot.db")
        c = conn.cursor()
        c.execute("INSERT OR REPLACE INTO filters VALUES (?, ?)", (update.effective_chat.id, word))
        conn.commit()
        conn.close()
        await update.message.reply_text(f"✅ Filter Word ထည့်သွင်းပြီးပါပြီ: `{word}`", parse_mode='Markdown')

# ----------------- Message Handler -----------------

async def handle_messages(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.message or not update.message.text: return
    chat_id = update.effective_chat.id
    user_id = update.effective_user.id
    text = update.message.text
    
    member = await update.effective_chat.get_member(user_id)
    if is_admin(member): 
        return

    conn = sqlite3.connect("group_bot.db")
    c = conn.cursor()

    # 1. Check Lock Settings
    c.execute("SELECT lock_url, lock_forward FROM settings WHERE chat_id=?", (chat_id,))
    settings = c.fetchone()
    if settings:
        lock_url, lock_forward = settings
        if lock_url and ("http://" in text or "https://" in text or "t.me/" in text):
            await update.message.delete()
            conn.close()
            return
        if lock_forward and update.message.forward_date:
            await update.message.delete()
            conn.close()
            return

    # 2. Check Blacklisted Filters
    c.execute("SELECT word FROM filters WHERE chat_id=?", (chat_id,))
    filters_list = [row[0] for row in c.fetchall()]
    for word in filters_list:
        if word in text.lower():
            await update.message.delete()
            conn.close()
            return

    # 3. Check AutoReplies
    c.execute("SELECT keyword, response FROM autoreplies WHERE chat_id=?", (chat_id,))
    replies = c.fetchall()
    for keyword, response in replies:
        if keyword in text.lower():
            await update.message.reply_text(response)
            break

    conn.close()

# ----------------- Main App Initialization -----------------

def main():
    app = ApplicationBuilder().token(BOT_TOKEN).build()

    # 1. Service Messages (Join, Left, Voice/Video Chat Started/Ended) Auto Delete
    service_filter = (
        filters.StatusUpdate.NEW_CHAT_MEMBERS |
        filters.StatusUpdate.LEFT_CHAT_MEMBER |
        filters.StatusUpdate.VOICE_CHAT_STARTED |
        filters.StatusUpdate.VOICE_CHAT_ENDED |
        )
    app.add_handler(MessageHandler(service_filter, delete_service_messages))

    # 2. Command Handlers
    app.add_handler(CommandHandler("ban", ban))
    app.add_handler(CommandHandler("unban", unban))
    app.add_handler(CommandHandler("mute", mute))
    app.add_handler(CommandHandler("unmute", unmute))
    app.add_handler(CommandHandler("kick", kick))
    app.add_handler(CommandHandler("warn", warn))
    app.add_handler(CommandHandler("unwarn", unwarn))
    app.add_handler(CommandHandler("warns", warns))
    
    app.add_handler(CommandHandler("lock", lock))
    app.add_handler(CommandHandler("unlock", unlock))
    
    app.add_handler(CommandHandler("autoreply", add_autoreply))
    app.add_handler(CommandHandler("filter", add_filter))

    # 3. Text Message Listener
    app.add_handler(MessageHandler(filters.TEXT & (~filters.COMMAND), handle_messages))

    print("Bot စတင်အလုပ်လုပ်နေပါပြီ...")
    app.run_polling()

if __name__ == "__main__":
    main()

